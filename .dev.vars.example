# Local settings for `npm run worker:dev` (wrangler dev). Copy to .dev.vars, which git ignores.
# Never put the real bot token here: local runs talk to the mock Telegram API below.
#   node worker/test/mock-telegram.mjs 8799

BOT_TOKEN=123456:local-test-token
WEBHOOK_SECRET=local-webhook-secret
SETUP_KEY=local-setup-key

# Lets the Vite dev server (http://localhost:5183) call the API without Telegram (local hosts only).
DEV_AUTH=1

TELEGRAM_API=http://127.0.0.1:8799
APP_URL=http://localhost:5183
