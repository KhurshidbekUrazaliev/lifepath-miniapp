# Local settings for `npm run worker:dev` (wrangler dev). Copy to .dev.vars, which git ignores.
# Never put the real bot token here: local runs talk to the mock Telegram API below.
#   node worker/test/mock-telegram.mjs 8799

BOT_TOKEN=123456:local-test-token
WEBHOOK_SECRET=local-webhook-secret
SETUP_KEY=local-setup-key

# Lets the Vite dev server (http://localhost:5183) call the API without Telegram (local hosts only).
DEV_AUTH=1

# Who may open the owner's panel: Telegram ids and @usernames, separated by commas.
# "@dev" is the user the local app signs in as. In production this is a secret:
#   npx wrangler secret put ADMINS
ADMINS=@dev

TELEGRAM_API=http://127.0.0.1:8799
APP_URL=http://localhost:5183

# Web push (worker/src/push.ts): a key pair for local runs. Make one with
#   node -e "const j=require('crypto').generateKeyPairSync('ec',{namedCurve:'prime256v1'}).privateKey.export({format:'jwk'});console.log('VAPID_PUBLIC='+Buffer.concat([Buffer.of(4),Buffer.from(j.x,'base64url'),Buffer.from(j.y,'base64url')]).toString('base64url')+'\nVAPID_PRIVATE='+j.d)"
# In production VAPID_PUBLIC is in wrangler.jsonc and VAPID_PRIVATE is a secret:
#   npx wrangler secret put VAPID_PRIVATE
