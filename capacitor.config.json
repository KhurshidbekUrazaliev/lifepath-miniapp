{
  "appId": "site.khurshidbek.lifepath",
  "appName": "LifePath",
  "webDir": "dist",
  "backgroundColor": "#070A13",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 3000,
      "backgroundColor": "#070A13",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_lifepath",
      "iconColor": "#8E6BF2"
    }
  }
}
