{
  "name": "lifepath-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5183 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5183 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "tsx src/lib/logic.test.ts && tsx src/lib/miniapp.test.ts && node scripts/companion-rig.test.mjs && node scripts/companion-moves.test.mjs && tsx scripts/check-i18n.ts",
    "test:logic": "tsx src/lib/logic.test.ts",
    "test:worker": "node worker/test/e2e.mjs",
    "worker:dev": "wrangler dev",
    "mock:telegram": "node worker/test/mock-telegram.mjs 8799",
    "deploy": "npm run build && wrangler deploy",
    "models": "node scripts/companion-models.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "adhan": "^4.4.6",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.86.0"
  }
}
