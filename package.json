{
  "name": "lifepath-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5183 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5183 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "tsx src/lib/logic.test.ts && tsx src/lib/miniapp.test.ts && tsx src/lib/home.test.ts && tsx src/lib/backup.test.ts && tsx src/lib/week.test.ts && tsx src/lib/journal-text.test.ts && tsx src/lib/together.test.ts && tsx src/lib/errors.test.ts && tsx src/lib/earn.test.ts && tsx src/lib/special.test.ts && node scripts/companion-rig.test.mjs && node scripts/companion-moves.test.mjs && tsx src/companion/pets.test.ts && tsx worker/test/daily.test.ts && tsx worker/test/hadith.test.ts && tsx scripts/check-i18n.ts",
    "test:logic": "tsx src/lib/logic.test.ts",
    "test:worker": "node worker/test/e2e.mjs",
    "worker:dev": "wrangler dev",
    "mock:telegram": "node worker/test/mock-telegram.mjs 8799",
    "deploy": "npm run build && wrangler deploy",
    "models": "node scripts/companion-models.mjs",
    "build:native": "tsc --noEmit && vite build --mode native",
    "android:sync": "npm run build:native && node scripts/cap.mjs sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../public/LifePath.apk",
    "android:icons": "node scripts/app-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "adhan": "^4.4.6",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.86.0"
  }
}
